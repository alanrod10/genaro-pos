# ==============================================================================
# Variables de Entorno y Secretos — Cloudflare Worker (GenaroPOS)
# ==============================================================================
# IMPORTANTE: No incluir valores reales en este archivo.
# En Cloudflare Workers, los secretos se inyectan mediante:
#   npx wrangler secret put <NOMBRE_VARIABLE> --env <staging|production>
# ==============================================================================

# --- Entorno y Red ---
ENVIRONMENT=staging
# Lista de orígenes adicionales para CORS separados por comas (ej. https://pos.tudominio.com)
# Los puertos locales de desarrollo (localhost/127.0.0.1) se autorizan automáticamente por defecto.
ALLOWED_ORIGINS=

# --- Base de Datos (Turso / libSQL) ---
# Requerida en staging y producción. Si no se provee, el Worker falla cerrado inmediatamente.
TURSO_DATABASE_URL=https://<nombre-db>-<organizacion>.aws-sa-east-1.turso.io
# Token de acceso JWT de Turso (secreto de infraestructura generado con `turso db tokens create`)
TURSO_AUTH_TOKEN=

# --- Criptografía y Sesiones JWT ---
# Secreto para firma HMAC-SHA-256 de tokens de sesión (mínimo 32 caracteres / 256 bits)
JWT_SECRET=
# Tiempo de expiración de las sesiones en horas (opcional, predeterminado: 24)
SESSION_TTL_HOURS=24

# --- Autenticación SCRAM-SHA-256 (RFC 5802) ---
# Secreto hexadecimal del servidor para ServerSignature (mínimo 64 caracteres hexadecimales = 32 bytes)
SCRAM_SERVER_SECRET=
# JSON con los verificadores criptográficos por usuario (salt, iteraciones, storedKey, serverKey, rol)
# Se genera mediante el script seguro de provisionamiento o migración de contraseñas.
SCRAM_VERIFIERS_JSON={"usuario_ejemplo":{"saltBase64":"...","iterations":4096,"storedKeyBase64":"...","serverKeyBase64":"...","role":"admin"}}

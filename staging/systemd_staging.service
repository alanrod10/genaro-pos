[Unit]
Description=Genaro Commercial Bridge Worker (Staging) — Servicio de Sincronizacion Outbox / Tesoreria
Documentation=https://github.com/alanrod10/genaro-pos-turso-lab
After=network.target

[Service]
Type=simple
User=alanrod10
Group=alanrod10
WorkingDirectory=/home/alanrod10/workspace/genaro-pos-turso-lab
EnvironmentFile=/home/alanrod10/workspace/genaro-pos-turso-lab/staging/.env.staging
ExecStart=/home/alanrod10/workspace/genaro-pos-turso-lab/.venv/bin/python /home/alanrod10/workspace/genaro-pos-turso-lab/scripts/run_commercial_bridge_worker.py --db-comm /home/alanrod10/workspace/genaro-pos-turso-lab/staging/genaro_pos_staging.db --db-tes /home/alanrod10/workspace/genaro-pos-turso-lab/staging/tesoreria_staging.db --pid-file /home/alanrod10/workspace/genaro-pos-turso-lab/staging/staging_bridge.pid --interval 2.0 --batch-size 50
ExecStop=/bin/kill -s TERM $MAINPID

# Reinicio automático y recuperación de fallos
Restart=always
RestartSec=3s

# Apagado ordenado
TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM

# Logs y entorno
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=genaro-bridge-staging

# Aislamiento de proceso
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

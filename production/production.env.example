# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN — GENARO POS & GENARO TESORERÍA
# ==============================================================================
# IMPORTANTE: Replicar como .env en el directorio de despliegue de Producción.
# No habilitar conexiones remotas a Turso hasta completar el Piloto Controlado.

GENARO_ENV=production
ISOLATION_MODE=STRICT_LOCAL_SQLITE

# Rutas de Base de Datos Locales
COMMERCIAL_DB_PATH=/home/alanrod10/production/data/genaro-pos.db
TESORERIA_DB_PATH=/home/alanrod10/production/data/tesoreria.db
BACKUPS_DIR=/home/alanrod10/backups

# Commercial Bridge Worker
BRIDGE_PID_FILE=/home/alanrod10/production/run/genaro_bridge.pid
BRIDGE_LOG_FILE=/home/alanrod10/production/logs/genaro_bridge.log
BRIDGE_WORKER_INTERVAL=5.0
BRIDGE_WORKER_BATCH_SIZE=50
BRIDGE_ORPHANED_TIMEOUT=30

# Cero Conexiones Remotas Iniciales (Desconectado de Turso)
TURSO_DEV_DATABASE_URL=
TURSO_DEV_AUTH_TOKEN=
TURSO_PROD_DATABASE_URL=
TURSO_PROD_AUTH_TOKEN=

# Seguridad y Autenticación
# ADVERTENCIA: Reemplazar con clave secreta generada mediante: openssl rand -hex 32
JWT_SECRET=GENERAR_CLAVE_ALEATORIA_CRIPTOGRAFICA_SEGURA_AQUI
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Servidor API FastAPI
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

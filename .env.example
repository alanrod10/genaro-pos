# Configuración de ejemplo para el laboratorio.
# Mantener SHEETS como predeterminado hasta activar cada módulo en DEV.
# No guardar tokens de producción en este archivo.

ENV_NAME=genaro-pos-dev
CATALOGO_BACKEND=SHEETS
SERVICIOS_BACKEND=SHEETS
VENTAS_BACKEND=SHEETS
TURSO_DEV_DATABASE_URL=
TURSO_DEV_AUTH_TOKEN=

# Autenticación y Control de Acceso (Solo Alan y Yilda)
# Clave secreta robusta para firma HMAC-SHA256 (mínimo 32 caracteres aleatorios)
GENARO_AUTH_SECRET_KEY=marcador_clave_secreta_minimo_32_caracteres_aleatorios
# Hashes PBKDF2-HMAC-SHA256 (formato pbkdf2_sha256$<iteraciones>$<salt_hex>$<hash_hex>)
GENARO_USER_ALAN_HASH=pbkdf2_sha256$600000$salt_ejemplo_hex$hash_ejemplo_hex
GENARO_USER_YILDA_HASH=pbkdf2_sha256$600000$salt_ejemplo_hex$hash_ejemplo_hex
# Duración de la sesión en minutos (opcional, por defecto 480 = 8 horas)
GENARO_AUTH_TOKEN_EXPIRE_MINUTES=480
